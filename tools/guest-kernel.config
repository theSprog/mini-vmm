# tools/guest-kernel.config — mini-vmm 测试 guest 内核的配置片段
#
# tools/build_guest_kernel.sh 以 x86_64_defconfig 为底，叠加本文件，再
# olddefconfig。这里只列 mini-vmm 的里程碑直接依赖、缺了测试就会失败的选项；
# 其余沿用 defconfig。构建脚本会逐条核对这些值最终都进了 .config，Kconfig
# 依赖不满足而被静默改掉时构建直接失败。
#
# 设备驱动一律 =y：BusyBox initramfs 里没有模块，也不加载模块，驱动编成 =m
# 时设备根本不会被探测。VMM 对 =m 配置的兼容由 arch-distro 的 Arch 官方内核
# 检验（见 HANDOFF.md「guest 内核配置兼容」）。

# 6.6.0 早于 host 上的新版 gcc，新编译器多出的警告在 defconfig 的 WERROR=y 下
# 会让构建失败，而这些警告和 guest 的行为无关
# CONFIG_WERROR is not set

# linux-boot：串口控制台、gzip 压缩的 initramfs、rcS 挂载的 devtmpfs
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y

# linux-boot、legacy-devices 用 "rtc_cmos rtc_cmos: setting system clock to"
# 证明 guest 从 CMOS RTC 读出了时间，这一行只在启动时用 RTC 设系统时间才打印
CONFIG_RTC_HCTOSYS=y

# defconfig 开着它：进程退出时刷新了最大栈深度就打印一行 "used greatest stack
# depth"，这行会插进 initramfs 用户态正在输出的一行中间，把测试匹配的文本拆断
# CONFIG_DEBUG_STACK_USAGE is not set

# smp
CONFIG_SMP=y

# pci-bus、pci-msi
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# emu-net：e1000
CONFIG_NET=y
CONFIG_INET=y
CONFIG_E1000=y

# emu-blk：AHCI 控制器上的 SATA 盘以 /dev/sda 出现
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y

# gdbstub：DWARF 让 gdb 能按源码行单步、列源码、看局部变量；GDB_SCRIPTS
# 在构建目录里生成 vmlinux-gdb.py，提供 lx-dmesg、lx-ps 这类按内核数据结构
# 解析的命令。调试信息不在任何 PT_LOAD 段里，VMM 装载内核时不会读到它，
# guest 的启动路径不受影响
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_GDB_SCRIPTS=y
