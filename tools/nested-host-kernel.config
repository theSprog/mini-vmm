# tools/nested-host-kernel.config — tools/nested_kvm.sh 用的 L1 内核配置片段
#
# L1 内核在 QEMU 里运行，同时又是 mini-vmm 的 host：它提供被测的 KVM，并通过
# virtio-9p 拿到 host 的根文件系统。以 x86_64_defconfig 加内核自带的
# kvm_guest.config 为底，再叠加本文件；构建脚本逐条核对这些值都进了 .config。

# 被测的 KVM 编进内核：L1 没有模块目录可加载。两个厂商都编进去，同一个内核
# 在 AMD 和 Intel host 上都能用；KVM_IOAPIC 提供 in-kernel PIC/IOAPIC/PIT，
# mini-vmm 默认的 --kernel-irqchip on 需要它
CONFIG_KVM=y
CONFIG_KVM_AMD=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_IOAPIC=y

# host 根文件系统经 virtio-9p 共享进来
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_VIRTIO_PCI=y
CONFIG_DEVTMPFS=y

# emu-net 的 --netdev tap 后端要 /dev/net/tun
CONFIG_TUN=y

# KVM selftests 里有几个用例要求 THP（set_memory_region_test、guest_memfd_test
# 等），顺带打开，同一个 L1 内核也能跑它们
CONFIG_TRANSPARENT_HUGEPAGE=y

# osrelease 带上 git 短哈希（例如 7.4.0-rc2-gcbe54fc3462b），日志第一行就能
# 看出测的是哪一版 KVM
CONFIG_LOCALVERSION_AUTO=y
